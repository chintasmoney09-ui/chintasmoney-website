{
  // Cloudflare Workers config for the ChintasMoney static site.
  // Serves the repository root as static assets (no build step).
  "name": "chintasmoney",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  // Public / non-secret vars (safe to commit). All SECRETS are set as encrypted
  // Worker secrets in the Cloudflare dashboard — never here. Secrets to add there:
  //   RAZORPAY_KEY_SECRET, ADMIN_PASSWORD, ADMIN_SESSION_SECRET,
  //   SUPABASE_SERVICE_ROLE_KEY
  "vars": {
    "RAZORPAY_KEY_ID": "rzp_test_TdCzS1NuNM4aQJ",
    "ADMIN_USER": "chintasmoney",
    "SUPABASE_URL": "https://voycwperlvcozshjambo.supabase.co"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
