{
  // Cloudflare Workers config for the ChintasMoney static site.
  // Serves the repository root as static assets (no build step).
  "name": "chintasmoney",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  // Public Razorpay Key ID (safe to commit). The SECRET is set as an encrypted
  // Worker secret in the Cloudflare dashboard — never here.
  "vars": {
    "RAZORPAY_KEY_ID": "rzp_test_TdCzS1NuNM4aQJ"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
