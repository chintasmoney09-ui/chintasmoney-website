{
  // Cloudflare Workers config for the ChintasMoney static site.
  // Serves the repository root as static assets (no build step).
  "name": "chintasmoney",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  // Public / non-secret vars (safe to commit). All SECRETS are set as encrypted
  // Worker secrets in the Cloudflare dashboard — never here. Secrets to add there:
  //   RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, ADMIN_PASSWORD,
  //   ADMIN_SESSION_SECRET, SUPABASE_SERVICE_ROLE_KEY
  //   RESEND_API_KEY   — (optional) Resend API key to email receipts to buyers
  //   RECEIPT_FROM     — (optional) e.g. "ChintasMoney <receipts@chintasmoney.com>"
  //   ANTHROPIC_API_KEY — (optional) enables the real AI Discipline Coach (Claude)
  //   COACH_MODEL      — (optional) override AI model id (default claude-haiku-4-5)
  // Plain (non-secret) vars live here so every deploy sets them — Cloudflare
  // wipes dashboard-only plain vars on deploy, so anything NOT secret must be
  // declared here. Secrets (RESEND_API_KEY, VAPID_PRIVATE_KEY, RAZORPAY_KEY_SECRET,
  // ADMIN_PASSWORD, ADMIN_SESSION_SECRET, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY)
  // stay in the Cloudflare dashboard only and are never committed.
  "vars": {
    "RAZORPAY_KEY_ID": "rzp_live_TghHwuaNLfCqIx",
    "ADMIN_USER": "chintasmoney",
    "SUPABASE_URL": "https://voycwperlvcozshjambo.supabase.co",
    "RECEIPT_FROM": "ChintasMoney <receipts@chintasmoney.com>",
    "OWNER_EMAIL": "chintasmoney@gmail.com",
    "VAPID_PUBLIC_KEY": "BJL78AyLgYx7eFt2hFgccnlyO0dA4SvOqjp4NtIJUXgJOTocA_gOiP8-twZmaWub4j0q3sArjvHPjW5IBLA2His"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Weekly discipline report email to Platinum/Diamond users.
  // Weekly report: Mondays 04:00 UTC = 09:30 IST.
  // Daily streak nudge: 12:30 UTC = 18:00 IST (evening reminder).
  "triggers": {
    "crons": ["0 4 * * 1", "30 12 * * *"]
  }
}
